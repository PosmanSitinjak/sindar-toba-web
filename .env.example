# ===============================================================
# KONFIGURASI SUPABASE SINDAR TOBA
# Dapatkan nilai ini dari Dashboard Supabase -> Project Settings -> API
# ===============================================================

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ===============================================================
# KONFIGURASI PAYMENT GATEWAY MIDTRANS SNAP (OPSIONAL / LIVE)
# Jika diisi, checkout akan memakai Midtrans Snap (QRIS & VA otomatis).
# Jika kosong, sistem menggunakan transfer/QRIS dengan konfirmasi manual.
# ===============================================================

MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
